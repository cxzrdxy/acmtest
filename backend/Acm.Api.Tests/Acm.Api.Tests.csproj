<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acm.Api\Acm.Api.csproj" />
    <!-- 引 Worker：其 dll 复制到测试输出目录，WorkerFixture 直接 Process.Start 启动 -->
    <ProjectReference Include="..\Acm.JudgeWorker\Acm.JudgeWorker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Worker 在输出目录读 appsettings.json（Judge 配置节），Link 保持原名随测试输出复制 -->
    <None Include="..\Acm.JudgeWorker\appsettings.json" CopyToOutputDirectory="PreserveNewest" Link="appsettings.json" />
  </ItemGroup>

</Project>
